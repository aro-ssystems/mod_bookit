{{!
    @template mod_bookit/view/room_legend

    Booking-facing room shortname legend above the calendar.

    Context variables required for this template:
    * overviewurl - URL to room overview page
    * previewhtml - Escaped HTML for overflow popover (shortnames)
    * hasrooms - Whether any active rooms exist
    * rooms - Array of:
      - shortname
      - name
      - tooltiphtml (escaped HTML: description + seats)
      - hascolor
      - eventcolor
      - textcolor

    Example context (json):
    {
      "overviewurl": "/mod/bookit/room_overview.php?id=5",
      "previewhtml": "A1, B2",
      "hasrooms": true,
      "rooms": [{"shortname":"A1","name":"Room A","tooltiphtml":"Desc&lt;br&gt;Seats: 10","hascolor":true,"eventcolor":"#3a87ad","textcolor":"#fff"}]
    }
}}
{{#hasrooms}}
<div class="bookit-room-legend" data-region="room-legend">
    <div class="bookit-room-legend-buttons" data-region="room-legend-buttons">
        {{#rooms}}
        <button type="button"
                class="btn btn-sm bookit-room-legend-btn{{^hascolor}} btn-outline-secondary{{/hascolor}}"
                {{#hascolor}}style="background-color: {{eventcolor}}; color: {{textcolor}}; border-color: {{eventcolor}};"{{/hascolor}}
                data-toggle="popover"
                data-bs-toggle="popover"
                data-trigger="hover focus"
                data-bs-trigger="hover focus"
                data-placement="bottom"
                data-bs-placement="bottom"
                data-html="true"
                data-bs-html="true"
                data-content="{{{tooltiphtml}}}"
                data-bs-content="{{{tooltiphtml}}}"
                title="{{name}}">
            {{shortname}}
        </button>
        {{/rooms}}
    </div>
    <div class="bookit-room-legend-overflow d-none" data-region="room-legend-overflow" hidden>
        <a href="{{overviewurl}}"
           class="btn btn-sm btn-secondary bookit-room-legend-overview"
           data-toggle="popover"
           data-bs-toggle="popover"
           data-trigger="hover focus"
           data-bs-trigger="hover focus"
           data-placement="bottom"
           data-bs-placement="bottom"
           data-html="true"
           data-bs-html="true"
           data-content="{{{previewhtml}}}"
           data-bs-content="{{{previewhtml}}}"
           title="{{#str}}room_overview, mod_bookit{{/str}}">
            {{#str}}room_overview, mod_bookit{{/str}}
        </a>
    </div>
</div>
{{/hasrooms}}
